{
  "name": "agent-host",
  "version": "0.3.0",
  "description": "Local control plane for discovering, observing, and controlling AI coding agents through one interface.",
  "type": "module",
  "bin": { "agent-host": "./src/cli.js" },
  "scripts": {
    "start": "node src/cli.js serve",
    "demo": "node src/cli.js demo",
    "fixtures:generate": "node scripts/generate-large-fixture.js",
    "conformance": "node --test test/client-conformance.test.js",
    "smoke:macos-service": "scripts/smoke-macos-launchagent.sh",
    "soak": "node --expose-gc scripts/soak.js --cycles=28800",
    "soak:quick": "node --expose-gc scripts/soak.js --cycles=2000",
    "release:build": "node scripts/build-release.js",
    "native:build": "node scripts/build-anchored-private-state-helper.js",
    "test:native:privileged": "node --test test/anchored-private-state.test.js test/cursor-sdk.test.js",
    "list": "node src/cli.js list",
    "test": "node --expose-gc --test test/**/*.test.js",
    "check": "find src -name '*.js' -exec node --check {} \\; && npm test"
  },
  "engines": { "node": ">=22 <25" },
  "license": "MIT"
}
